<Page x:Class="SerkonDiskSuite.App.Views.Pages.BenchmarkPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:SerkonDiskSuite.App.Converters"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:viewModels="clr-namespace:SerkonDiskSuite.App.ViewModels"
      Title="Benchmark"
      MinHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Frame}}"
      d:DataContext="{d:DesignInstance Type=viewModels:BenchmarkViewModel}"
      mc:Ignorable="d">

    <ui:Card Margin="0,0,8,8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Performans Testi" Style="{StaticResource Heading}" />

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8">
                <TextBlock Text="Hedef sürücü: " VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding AvailableDriveLetters}"
                          SelectedItem="{Binding SelectedDriveLetter}"
                          Width="70" VerticalAlignment="Center" />
                <TextBlock Text="⚠ Sistem diski seçili — bu diski test etmek riskli olabilir!"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0"
                           Visibility="{Binding IsSystemDriveSelected, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                <TextBlock Text="   Boyut (GiB): " VerticalAlignment="Center" Margin="16,0,0,0" />
                <TextBox Text="{Binding TestSizeGiB}" Width="50" VerticalAlignment="Center" />
                <TextBlock Text="   Geçiş: " VerticalAlignment="Center" Margin="16,0,0,0" />
                <TextBox Text="{Binding Passes}" Width="40" VerticalAlignment="Center" />
                <TextBlock Text="   Blok boyutu (rastgele): " VerticalAlignment="Center" Margin="16,0,0,0" />
                <ComboBox ItemsSource="{Binding BlockSizeOptionsKiB}"
                          SelectedItem="{Binding RandomBlockSizeKiB}"
                          IsEnabled="{Binding IsRandomLocked, Converter={x:Static conv:InverseBooleanConverter.Instance}}"
                          Width="90" VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="{Binding Mode=OneWay}" /><Run Text=" KiB" />
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="   Profil: " VerticalAlignment="Center" Margin="16,0,0,0" />
                <ComboBox ItemsSource="{Binding Profiles}"
                          SelectedItem="{Binding SelectedProfile}"
                          DisplayMemberPath="Name"
                          Width="140" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Sıralı/rastgele için ayrı Q(kuyruk derinliği)/T(iş parçacığı) — madde C1.
                 Bir profil seçiliyse, o profilin belirlediği kategori salt-okunur (madde C2). -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Sıralı Q/T: " VerticalAlignment="Center" />
                <TextBox Text="{Binding SequentialQueueDepth}" Width="36" VerticalAlignment="Center"
                          IsEnabled="{Binding IsSequentialLocked, Converter={x:Static conv:InverseBooleanConverter.Instance}}" />
                <TextBlock Text=" / " VerticalAlignment="Center" />
                <TextBox Text="{Binding SequentialThreadCount}" Width="36" VerticalAlignment="Center"
                          IsEnabled="{Binding IsSequentialLocked, Converter={x:Static conv:InverseBooleanConverter.Instance}}" />
                <TextBlock Text="   Rastgele Q/T: " VerticalAlignment="Center" Margin="16,0,0,0" />
                <TextBox Text="{Binding RandomQueueDepth}" Width="36" VerticalAlignment="Center"
                          IsEnabled="{Binding IsRandomLocked, Converter={x:Static conv:InverseBooleanConverter.Instance}}" />
                <TextBlock Text=" / " VerticalAlignment="Center" />
                <TextBox Text="{Binding RandomThreadCount}" Width="36" VerticalAlignment="Center"
                          IsEnabled="{Binding IsRandomLocked, Converter={x:Static conv:InverseBooleanConverter.Instance}}" />
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8">
                <ui:Button Content="Testi Başlat" Appearance="Primary" Command="{Binding StartCommand}" />
                <ui:Button Content="İptal" Command="{Binding CancelCommand}" Margin="8,0,0,0"
                           Appearance="Danger"
                           Visibility="{Binding IsRunning, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
            </StackPanel>

            <ProgressBar Grid.Row="4" Margin="0,8" Minimum="0" Maximum="100"
                         Value="{Binding ProgressPercent, Mode=OneWay}" />
            <TextBlock Grid.Row="5" Text="{Binding ProgressMessage}" Style="{StaticResource Muted}" />

            <!-- Sonuç kartları: kalan tüm dikey alanı doldurur, gerekirse kendi içinde kaydırır -->
            <ScrollViewer Grid.Row="6" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Results}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card Margin="0,4">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Kind, Converter={StaticResource BenchmarkTestKindToString}}"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center">
                                            <Run Text=" (" /><Run Text="{Binding ProfileName, Mode=OneWay}" />
                                            <Run Text=" Q" /><Run Text="{Binding QueueDepth, Mode=OneWay}" />
                                            <Run Text="T" /><Run Text="{Binding ThreadCount, Mode=OneWay}" />
                                            <Run Text=")" />
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,12,0"
                                                   Visibility="{Binding Iops, Converter={x:Static conv:NullToVisibilityConverter.Instance}}">
                                            <Run Text="{Binding Iops, Converter={StaticResource NumberToString}, Mode=OneWay}" />
                                            <Run Text=" IOPS" />
                                        </TextBlock>
                                        <TextBlock FontSize="18" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}" VerticalAlignment="Center">
                                            <Run Text="{Binding ThroughputMBps, Converter={StaticResource NumberToString}, Mode=OneWay}" />
                                            <Run Text=" MB/s" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </ui:Card>
</Page>
