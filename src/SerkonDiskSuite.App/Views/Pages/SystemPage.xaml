<Page x:Class="SerkonDiskSuite.App.Views.Pages.SystemPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:viewModels="clr-namespace:SerkonDiskSuite.App.ViewModels"
      Title="Sistem"
      d:DataContext="{d:DesignInstance Type=viewModels:SystemViewModel}"
      mc:Ignorable="d">

    <ui:Card Margin="0,0,8,8">
        <StackPanel>
            <TextBlock Text="Sistem Bilgisi" Style="{StaticResource Heading}" />
            <StackPanel DataContext="{Binding Summary}">
                <TextBlock Margin="0,4">
                    <Run Text="İşletim Sistemi: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Run Text="{Binding OsName, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Margin="0,4">
                    <Run Text="İşlemci: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Run Text="{Binding CpuName, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Margin="0,4">
                    <Run Text="Anakart: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Run Text="{Binding MotherboardName, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Margin="0,4">
                    <Run Text="BIOS: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Run Text="{Binding BiosVersion, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </StackPanel>
    </ui:Card>
</Page>
