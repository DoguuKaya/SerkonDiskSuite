<Page x:Class="SerkonDiskSuite.App.Views.Pages.HealthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:SerkonDiskSuite.App.Converters"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:viewModels="clr-namespace:SerkonDiskSuite.App.ViewModels"
      Title="Sağlık (SMART)"
      x:Name="Root"
      MinHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Frame}}"
      d:DataContext="{d:DesignInstance Type=viewModels:HealthViewModel}"
      mc:Ignorable="d">

    <ui:Card Margin="0,0,8,8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock Text="Disk Sağlığı" Style="{StaticResource Heading}" />
                <ui:Button Content="Yenile" Appearance="Secondary" HorizontalAlignment="Right"
                           Command="{Binding RefreshCommand}" />
            </Grid>

            <TextBlock Grid.Row="1" Text="{Binding Error}" Style="{StaticResource ErrorText}" Margin="0,4"
                       Visibility="{Binding Error, Converter={x:Static conv:NullToVisibilityConverter.Instance}}" />

            <!-- Özet kutuları -->
            <UniformGrid Grid.Row="2" Columns="3" Margin="0,8"
                         Visibility="{Binding Health, Converter={x:Static conv:NullToVisibilityConverter.Instance}}">
                <ui:Card Margin="4">
                    <StackPanel>
                        <TextBlock Text="Durum" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding Health.OverallStatus}"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{Binding Health.OverallStatus, Converter={StaticResource HealthToBrush}}" />
                    </StackPanel>
                </ui:Card>
                <ui:Card Margin="4">
                    <StackPanel>
                        <TextBlock Text="Sıcaklık" Style="{StaticResource Muted}" />
                        <TextBlock FontSize="20" FontWeight="Bold">
                            <Run Text="{Binding Health.TemperatureCelsius, Mode=OneWay}" />
                            <Run Text="°C" />
                        </TextBlock>
                    </StackPanel>
                </ui:Card>
                <ui:Card Margin="4">
                    <StackPanel>
                        <TextBlock Text="Kalan Ömür" Style="{StaticResource Muted}" />
                        <TextBlock FontSize="20" FontWeight="Bold">
                            <Run Text="{Binding Health.RemainingLifePercent, Mode=OneWay}" />
                            <Run Text="%" />
                        </TextBlock>
                    </StackPanel>
                </ui:Card>
                <ui:Card Margin="4">
                    <StackPanel>
                        <TextBlock Text="Kullanılabilir Yedek" Style="{StaticResource Muted}" />
                        <TextBlock FontSize="20" FontWeight="Bold">
                            <Run Text="{Binding Health.AvailableSparePercent, Mode=OneWay}" />
                            <Run Text="%" />
                        </TextBlock>
                    </StackPanel>
                </ui:Card>
                <ui:Card Margin="4">
                    <StackPanel>
                        <TextBlock Text="Açılma Sayısı" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding Health.PowerCycleCount, Mode=OneWay}"
                                   FontSize="20" FontWeight="Bold" />
                    </StackPanel>
                </ui:Card>
                <ui:Card Margin="4">
                    <StackPanel>
                        <TextBlock Text="Güvensiz Kapanma" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding Health.UnsafeShutdowns, Converter={StaticResource CountToString}, Mode=OneWay}"
                                   FontSize="20" FontWeight="Bold" />
                    </StackPanel>
                </ui:Card>
                <ui:Card Margin="4">
                    <StackPanel>
                        <TextBlock Text="Çalışma Süresi" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding Health.PowerOnHours, Converter={StaticResource HoursToString}, Mode=OneWay}"
                                   FontSize="20" FontWeight="Bold" />
                    </StackPanel>
                </ui:Card>
                <ui:Card Margin="4">
                    <StackPanel>
                        <TextBlock Text="Toplam Okunan" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding Health.TotalBytesRead, Converter={StaticResource BytesToString}, Mode=OneWay}"
                                   FontSize="20" FontWeight="Bold" />
                    </StackPanel>
                </ui:Card>
                <ui:Card Margin="4">
                    <StackPanel>
                        <TextBlock Text="Toplam Yazılan" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding Health.TotalBytesWritten, Converter={StaticResource BytesToString}, Mode=OneWay}"
                                   FontSize="20" FontWeight="Bold" />
                    </StackPanel>
                </ui:Card>
            </UniformGrid>

            <!-- Gerçek zamanlı sıcaklık grafiği (son 15 dakika) -->
            <ui:Card Grid.Row="3" Margin="0,8,0,0" Padding="8" Height="160">
                <lvc:CartesianChart Series="{Binding TemperatureSeries}"
                                     XAxes="{Binding TemperatureXAxes}"
                                     YAxes="{Binding TemperatureYAxes}"
                                     SyncContext="{Binding ChartSyncObject}" />
            </ui:Card>

            <!-- Trend geçmişi: tüm kayıtlı geçmiş (canlı grafiğin 15 dakikalık penceresinden bağımsız) -->
            <TextBlock Grid.Row="4" Text="Trend Geçmişi (Tüm Kayıt)" Style="{StaticResource Heading}" Margin="0,12,0,4" />
            <Grid Grid.Row="5" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Card Grid.Column="0" Margin="0,0,4,0" Padding="8" Height="160">
                    <lvc:CartesianChart Series="{Binding HistoryTemperatureSeries}"
                                         XAxes="{Binding HistoryXAxes}"
                                         YAxes="{Binding HistoryTemperatureYAxes}"
                                         SyncContext="{Binding ChartSyncObject}" />
                </ui:Card>
                <ui:Card Grid.Column="1" Margin="4,0,0,0" Padding="8" Height="160">
                    <lvc:CartesianChart Series="{Binding HistoryRemainingLifeSeries}"
                                         XAxes="{Binding HistoryXAxes}"
                                         YAxes="{Binding HistoryRemainingLifeYAxes}"
                                         SyncContext="{Binding ChartSyncObject}" />
                </ui:Card>
            </Grid>

            <!-- Öznitelik tablosu -->
            <TextBlock Grid.Row="6" Text="SMART Öznitelikleri" Style="{StaticResource Heading}" Margin="0,12,0,4" />
            <DataGrid Grid.Row="7" ItemsSource="{Binding Attributes}">
                <DataGrid.Resources>
                    <!-- DataGridColumn görsel ağaçta olmadığından ElementName ile Page'in
                         DataContext'ine ulaşılamıyor; standart çözüm bir FrameworkElement
                         proxy'dir: DataContext'i {Binding} ile (DataGrid'in kendi, miras
                         alınan DataContext'ine) bağlanır, kolonlar buna Source olarak bakar. -->
                    <FrameworkElement x:Key="ProxyElement" DataContext="{Binding}" />
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"
                                         Visibility="{Binding DataContext.IsIdColumnVisible, Source={StaticResource ProxyElement}, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                    <DataGridTextColumn Header="Öznitelik" Width="*"
                                         Binding="{Binding Converter={StaticResource SmartAttributeName}}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="ToolTip" Value="{Binding Name}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Değer" Width="180"
                                         Binding="{Binding Converter={StaticResource SmartAttributeValue}}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </ui:Card>
</Page>
