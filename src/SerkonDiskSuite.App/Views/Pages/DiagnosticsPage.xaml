<Page x:Class="SerkonDiskSuite.App.Views.Pages.DiagnosticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:SerkonDiskSuite.App.Converters"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:viewModels="clr-namespace:SerkonDiskSuite.App.ViewModels"
      Title="Teşhis"
      MinHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Frame}}"
      d:DataContext="{d:DesignInstance Type=viewModels:DiagnosticsViewModel}"
      mc:Ignorable="d">

    <ui:Card Margin="0,0,8,8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Teşhis" Style="{StaticResource Heading}" />

            <TextBlock Grid.Row="1" Margin="0,4,0,12">
                <Run Text="Firmware sürümü: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <Run Text="{Binding FirmwareVersion, Mode=OneWay}" />
            </TextBlock>

            <!-- Kritik uyarı bayrakları (NVMe) -->
            <StackPanel Grid.Row="2" Margin="0,0,0,12"
                        Visibility="{Binding CriticalWarningFlags, Converter={x:Static conv:NullToVisibilityConverter.Instance}}">
                <TextBlock Text="Kritik Uyarılar" Style="{StaticResource Muted}" />
                <ItemsControl ItemsSource="{Binding CriticalWarningFlags}" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       Margin="0,2" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Self-test başlatma -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Self-test türü: " VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding SelfTestTypes}"
                          SelectedItem="{Binding SelectedSelfTestType}"
                          Width="90" VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource SelfTestTypeToString}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ui:Button Content="Başlat" Appearance="Primary" Margin="12,0,0,0"
                           Command="{Binding StartSelfTestCommand}" />
                <ui:Button Content="Yenile" Appearance="Secondary" Margin="8,0,0,0"
                           Command="{Binding RefreshCommand}" />
            </StackPanel>

            <!-- Self-test durumu -->
            <ui:Card Grid.Row="4" Margin="0,0,0,8" Padding="12,10">
                <StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}"
                               Visibility="{Binding StatusMessage, Converter={x:Static conv:NullToVisibilityConverter.Instance}}" />
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding SelfTestStatus, Converter={x:Static conv:NullToVisibilityConverter.Instance}}">
                        <TextBlock VerticalAlignment="Center">
                            <Run Text="Durum: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Run Text="{Binding SelfTestStatus.StatusDescription, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding SelfTestStatus.IsRunning, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                            <Run Text="Kalan: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Run Text="{Binding SelfTestStatus.PercentRemaining, Mode=OneWay}" />
                            <Run Text="%" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </ui:Card>
        </Grid>
    </ui:Card>
</Page>
