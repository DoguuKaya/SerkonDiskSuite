<Window x:Class="SerkonDiskSuite.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SerkonDiskSuite.App.Converters"
        Title="Serkon Disk Suite" Height="720" Width="1180"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:HealthToBrushConverter x:Key="HealthToBrush" />
        <conv:BytesToStringConverter x:Key="BytesToString" />
    </Window.Resources>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Üst başlık -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="12,8">
            <TextBlock Text="Serkon Disk Suite" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="  •  disk sağlığı, benchmark ve izleme" Style="{StaticResource Muted}"
                       VerticalAlignment="Bottom" Margin="0,0,0,4" />
        </StackPanel>

        <!-- Sol: disk listesi -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Diskler" Style="{StaticResource Heading}" />
                <Button DockPanel.Dock="Bottom" Content="Yenile" Margin="0,8,0,0"
                        Command="{Binding LoadCommand}" />
                <ListBox ItemsSource="{Binding Disks}"
                         SelectedItem="{Binding SelectedDisk}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceAltBrush}"
                                    CornerRadius="8" Padding="12" Margin="0,4">
                                <StackPanel>
                                    <TextBlock Text="{Binding ModelName}" FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0">
                                        <Run Text="{Binding CapacityDisplay, Mode=OneWay}" />
                                        <Run Text=" • " />
                                        <Run Text="{Binding BusType, Mode=OneWay}" />
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding DriveLetters}" Margin="0,4,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource AccentBrush}"
                                                        CornerRadius="4" Padding="6,2" Margin="0,0,4,0">
                                                    <TextBlock Text="{Binding}" FontSize="11" Foreground="White" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Sağ: sekmeler -->
        <TabControl Grid.Row="1" Grid.Column="1" Background="Transparent" BorderThickness="0"
                    Margin="8">
            <!-- Sağlık sekmesi -->
            <TabItem Header="Sağlık (SMART)">
                <Border Style="{StaticResource Card}" DataContext="{Binding Health}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Disk Sağlığı" Style="{StaticResource Heading}" />
                                <Button Content="Yenile" HorizontalAlignment="Right"
                                        Command="{Binding RefreshCommand}" />
                            </Grid>

                            <TextBlock Text="{Binding Error}" Foreground="{StaticResource BadBrush}"
                                       TextWrapping="Wrap" Margin="0,4"
                                       Visibility="{Binding Error, Converter={x:Static conv:NullToVisibilityConverter.Instance}}" />

                            <!-- Özet kutuları -->
                            <UniformGrid Columns="4" Margin="0,8"
                                         Visibility="{Binding Health, Converter={x:Static conv:NullToVisibilityConverter.Instance}}">
                                <Border Style="{StaticResource Card}" Background="{StaticResource SurfaceAltBrush}">
                                    <StackPanel>
                                        <TextBlock Text="Durum" Style="{StaticResource Muted}" />
                                        <TextBlock Text="{Binding Health.OverallStatus}"
                                                   FontSize="20" FontWeight="Bold"
                                                   Foreground="{Binding Health.OverallStatus, Converter={StaticResource HealthToBrush}}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Background="{StaticResource SurfaceAltBrush}">
                                    <StackPanel>
                                        <TextBlock Text="Sıcaklık" Style="{StaticResource Muted}" />
                                        <TextBlock FontSize="20" FontWeight="Bold">
                                            <Run Text="{Binding Health.TemperatureCelsius, Mode=OneWay}" />
                                            <Run Text="°C" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Background="{StaticResource SurfaceAltBrush}">
                                    <StackPanel>
                                        <TextBlock Text="Kalan Ömür" Style="{StaticResource Muted}" />
                                        <TextBlock FontSize="20" FontWeight="Bold">
                                            <Run Text="{Binding Health.RemainingLifePercent, Mode=OneWay}" />
                                            <Run Text="%" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Background="{StaticResource SurfaceAltBrush}">
                                    <StackPanel>
                                        <TextBlock Text="Açılma Sayısı" Style="{StaticResource Muted}" />
                                        <TextBlock Text="{Binding Health.PowerCycleCount, Mode=OneWay}"
                                                   FontSize="20" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Öznitelik tablosu -->
                            <TextBlock Text="SMART Öznitelikleri" Style="{StaticResource Heading}" Margin="0,12,0,4" />
                            <DataGrid ItemsSource="{Binding Attributes}" AutoGenerateColumns="False"
                                      IsReadOnly="True" HeadersVisibility="Column"
                                      Background="Transparent" RowBackground="{StaticResource SurfaceAltBrush}"
                                      GridLinesVisibility="None" BorderThickness="0" MaxHeight="320">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" />
                                    <DataGridTextColumn Header="İsim" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="Değer" Binding="{Binding RawValue}" Width="160" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- Benchmark sekmesi -->
            <TabItem Header="Benchmark">
                <Border Style="{StaticResource Card}" DataContext="{Binding Benchmark}">
                    <StackPanel>
                        <TextBlock Text="Performans Testi" Style="{StaticResource Heading}" />

                        <StackPanel Orientation="Horizontal" Margin="0,8">
                            <TextBlock Text="Hedef sürücü: " VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TargetDrive}" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock Text="   Boyut (GiB): " VerticalAlignment="Center" Margin="16,0,0,0" />
                            <TextBox Text="{Binding TestSizeGiB}" Width="50" VerticalAlignment="Center"
                                     Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource TextBrush}"
                                     BorderThickness="0" Padding="6,4" />
                            <TextBlock Text="   Geçiş: " VerticalAlignment="Center" Margin="16,0,0,0" />
                            <TextBox Text="{Binding Passes}" Width="40" VerticalAlignment="Center"
                                     Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource TextBrush}"
                                     BorderThickness="0" Padding="6,4" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,8">
                            <Button Content="Testi Başlat" Command="{Binding StartCommand}" />
                            <Button Content="İptal" Command="{Binding CancelCommand}" Margin="8,0,0,0"
                                    Background="{StaticResource BadBrush}"
                                    Visibility="{Binding IsRunning, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                        </StackPanel>

                        <ProgressBar Height="6" Margin="0,8" IsIndeterminate="{Binding IsRunning}"
                                     Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource AccentBrush}"
                                     BorderThickness="0" />
                        <TextBlock Text="{Binding ProgressMessage}" Style="{StaticResource Muted}" />

                        <!-- Sonuç kartları -->
                        <ItemsControl ItemsSource="{Binding Results}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8"
                                            Padding="14" Margin="0,4">
                                        <Grid>
                                            <TextBlock Text="{Binding Kind}" FontWeight="SemiBold" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock FontSize="18" FontWeight="Bold"
                                                           Foreground="{StaticResource AccentBrush}">
                                                    <Run Text="{Binding ThroughputMBps, StringFormat=N0, Mode=OneWay}" />
                                                    <Run Text=" MB/s" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- Sistem sekmesi -->
            <TabItem Header="Sistem">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Sistem Bilgisi" Style="{StaticResource Heading}" />
                        <StackPanel DataContext="{Binding System}">
                            <TextBlock Margin="0,4"><Run Text="İşletim Sistemi: " Foreground="#FF9AA0A8" /><Run Text="{Binding OsName, Mode=OneWay}" /></TextBlock>
                            <TextBlock Margin="0,4"><Run Text="İşlemci: " Foreground="#FF9AA0A8" /><Run Text="{Binding CpuName, Mode=OneWay}" /></TextBlock>
                            <TextBlock Margin="0,4"><Run Text="Anakart: " Foreground="#FF9AA0A8" /><Run Text="{Binding MotherboardName, Mode=OneWay}" /></TextBlock>
                            <TextBlock Margin="0,4"><Run Text="BIOS: " Foreground="#FF9AA0A8" /><Run Text="{Binding BiosVersion, Mode=OneWay}" /></TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Alt durum çubuğu -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource SurfaceBrush}"
                CornerRadius="8" Padding="12,6" Margin="8,0,8,4">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" />
        </Border>
    </Grid>
</Window>
