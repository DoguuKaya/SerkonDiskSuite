<ui:FluentWindow x:Class="SerkonDiskSuite.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:conv="clr-namespace:SerkonDiskSuite.App.Converters"
                 xmlns:pages="clr-namespace:SerkonDiskSuite.App.Views.Pages"
                 Title="Serkon Disk Suite" Height="760" Width="1280"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen"
                 HorizontalContentAlignment="Stretch"
                 VerticalContentAlignment="Stretch">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Serkon Disk Suite" />

        <!-- Disk detay şeridi (seçili diskin donanım bilgileri) -->
        <ui:Card Grid.Row="1" Margin="8,0,8,8" Padding="12,10"
                 Visibility="{Binding SelectedDisk, Converter={x:Static conv:NullToVisibilityConverter.Instance}}">
            <WrapPanel Orientation="Horizontal" DataContext="{Binding SelectedDisk}">
                <TextBlock Text="{Binding ModelName}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" Margin="0,0,16,0" />

                <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="Tür: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Run Text="{Binding IsSolidState, Converter={StaticResource SolidStateToString}, Mode=OneWay}" />
                        <Run Text=" / " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Run Text="{Binding BusType, Converter={StaticResource BusTypeToString}, Mode=OneWay}" />
                    </TextBlock>
                </Border>

                <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,8,0"
                        Visibility="{Binding TransferMode, Converter={x:Static conv:NullToVisibilityConverter.Instance}}">
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="Bağlantı: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Run Text="{Binding TransferMode, Mode=OneWay}" />
                    </TextBlock>
                </Border>

                <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="Firmware: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Run Text="{Binding FirmwareVersion, Mode=OneWay}" />
                    </TextBlock>
                </Border>

                <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="8,4">
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="Seri No: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Run Text="{Binding SerialNumber, Mode=OneWay}" />
                    </TextBlock>
                </Border>
            </WrapPanel>
        </ui:Card>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sol: disk listesi -->
            <ui:Card Grid.Column="0" Margin="8,0,4,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Diskler" Style="{StaticResource Heading}" />
                    <ui:Button DockPanel.Dock="Bottom" Content="Yenile" Appearance="Secondary" Margin="0,8,0,0"
                               Command="{Binding LoadCommand}" />
                    <ListBox ItemsSource="{Binding Disks}"
                             SelectedItem="{Binding SelectedDisk}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        CornerRadius="8" Padding="12" Margin="0,4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ModelName}" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0">
                                            <Run Text="{Binding CapacityDisplay, Mode=OneWay}" />
                                            <Run Text=" • " />
                                            <Run Text="{Binding BusType, Converter={StaticResource BusTypeToString}, Mode=OneWay}" />
                                        </TextBlock>
                                        <ItemsControl ItemsSource="{Binding DriveLetters}" Margin="0,4,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                            CornerRadius="4" Padding="6,2" Margin="0,0,4,0">
                                                        <TextBlock Text="{Binding}" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </ui:Card>

            <!-- Sağ: Sağlık / Benchmark / Sistem sayfaları -->
            <ui:NavigationView x:Name="RootNavigation" Grid.Column="1" Margin="4,0,8,8"
                               PaneDisplayMode="Top" IsPaneToggleVisible="False"
                               IsBackButtonVisible="Collapsed">
                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem Content="Sağlık" Icon="{ui:SymbolIcon Heart24}"
                                            TargetPageType="{x:Type pages:HealthPage}" />
                    <ui:NavigationViewItem Content="Benchmark" Icon="{ui:SymbolIcon DataHistogram24}"
                                            TargetPageType="{x:Type pages:BenchmarkPage}" />
                    <ui:NavigationViewItem Content="Sistem" Icon="{ui:SymbolIcon Desktop24}"
                                            TargetPageType="{x:Type pages:SystemPage}" />
                    <ui:NavigationViewItem Content="Teşhis" Icon="{ui:SymbolIcon Wrench24}"
                                            TargetPageType="{x:Type pages:DiagnosticsPage}" />
                </ui:NavigationView.MenuItems>
            </ui:NavigationView>
        </Grid>

        <!-- Alt durum çubuğu -->
        <ui:Card Grid.Row="3" Margin="8,0,8,8" Padding="12,6">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" />
        </ui:Card>
    </Grid>
</ui:FluentWindow>
