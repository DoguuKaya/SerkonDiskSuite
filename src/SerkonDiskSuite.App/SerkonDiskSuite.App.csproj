<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SerkonDiskSuite</AssemblyName>
    <Version>1.0.4</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);NU1701</NoWarn>

    <!-- Tek dosya, kendi kendine yeten yayın için (dotnet publish) -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Başlangıç hızı için önceden JIT edilmiş kod (AOT değil, hâlâ JIT'e düşebilir). -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- AÇIKÇA false: varsayılan da false ama DisplayFormatting.cs tr-TR'ye (binlik/ondalık
         ayraç) bağımlı olduğundan, ileride biri "boyutu küçült" diye Invariant modu true
         yaparsa tüm sayı/tarih biçimlendirmesi bozulur — bu niyet burada açıkça belgeleniyor. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.5" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SerkonDiskSuite.Core\SerkonDiskSuite.Core.csproj" />
    <ProjectReference Include="..\SerkonDiskSuite.Infrastructure\SerkonDiskSuite.Infrastructure.csproj" />
  </ItemGroup>

  <!-- smartctl.exe'yi çıktı ile birlikte tools/ altına kopyala (varsa). icon-gen/ hariç
       tutulur — o, ikon üretmek için bir kerelik çalıştırılan geliştirici aracı, uygulamanın
       kendisiyle dağıtılmaması gerekir (kaynak kodu + kendi bin/obj'unu publish çıktısına
       sızdırıyordu, gerçek publish testinde bulundu). -->
  <ItemGroup>
    <None Include="..\..\tools\**\*" Exclude="..\..\tools\icon-gen\**\*" Link="tools\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" Condition="Exists('..\..\tools')" />
  </ItemGroup>

  <!-- MainWindow.xaml'ın Icon="Assets/app.ico" bağlaması (pack URI ile pencere sol üst
       simgesi) için WPF kaynağı olarak dahil edilir; ApplicationIcon (üstte) ise .exe'nin
       ve görev çubuğunun kendi Win32 simgesini ayrıca gömer — ikisi de gerekli. -->
  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
